# 本机 pnpm 全局 store 在 D 盘（沙箱不可写），因此把 store/cache 固定到项目内。
# 用绝对路径 + 正斜杠：pnpm 对相对 store-dir 的解析不稳定。
store-dir=C:/Users/33281/Desktop/测试/.pnpm-store
cache-dir=C:/Users/33281/Desktop/测试/.pnpm-cache
# Windows 下 pnpm 的符号链接在部分环境会栈溢出（ERR_PNPM_SYMLINK_FAILED），
# 改用扁平 node_modules（与 npm 布局一致），对 NestJS/Vite 均无副作用。
node-linker=hoisted
strict-peer-dependencies=false
