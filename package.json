{
  "name": "ai-chat-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter @app/web dev",
    "build:web": "pnpm --filter @app/web build",
    "build:contract": "pnpm --filter @app/contract build",
    "dev:api": "pnpm build:contract && pnpm --filter @app/api start:dev",
    "build:api": "pnpm build:contract && pnpm --filter @app/api build",
    "start:api": "pnpm --filter @app/api start",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @app/api prisma:generate",
    "db:migrate": "pnpm --filter @app/api prisma:migrate",
    "db:studio": "pnpm --filter @app/api prisma:studio",
    "db:seed": "pnpm --filter @app/api db:seed"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^5.7.3"
  }
}
