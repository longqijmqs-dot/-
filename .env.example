# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不会进版本库。
# 所有值都是示例，真实密钥必须自己生成，不要复用这里的字符串。

# ---------- MySQL ----------
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
MYSQL_DATABASE=ai_chat
MYSQL_USER=aichat
MYSQL_PASSWORD=replace_with_strong_app_password

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password

# ---------- 后端（apps/api） ----------
# Prisma 连接串：注意密码里的特殊字符需要 URL 编码
DATABASE_URL="mysql://aichat:replace_with_strong_app_password@localhost:3306/ai_chat"
REDIS_URL="redis://:replace_with_strong_redis_password@localhost:6379"

# ---------- JWT ----------
# 用 `openssl rand -base64 48` 生成，两个必须不同
JWT_ACCESS_SECRET=replace_with_random_48_bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_with_random_48_bytes
JWT_REFRESH_TTL=7d

# bcrypt 成本因子（生产 >= 10，测试环境可调到 4 加速）
BCRYPT_ROUNDS=12

# ---------- 其他 ----------
NODE_ENV=development
PORT=3000
# 允许跨域的前端地址（开发期走 Vite 代理，一般用不到）
CORS_ORIGIN=http://localhost:5173
