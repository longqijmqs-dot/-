# ============================================================
# 前端 Web Dockerfile（多阶段构建）
#
# 阶段 1：用 Node.js 构建 Vue 静态文件
# 阶段 2：用 Nginx 托管静态文件 + 反向代理 /api 到后端
#
# Nginx 在这里做两件事：
#   1. 托管构建好的前端静态文件（HTML/CSS/JS）
#   2. 把 /api 请求转发到后端容器（同源，避免 CORS）
# ============================================================

# ---------- 阶段 1：构建 ----------
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/ ./packages/
COPY apps/ ./apps/

# 基础镜像里默认没有 pnpm。
# 优先用 corepack（与 package.json 的 packageManager 字段一致）；
# 若 corepack 因签名校验/网络问题失败，回退到 npm 直接安装，保证构建可用。
# COREPACK_ENABLE_DOWNLOAD_PROMPT=0：非交互构建下禁止 corepack 弹出
# “是否下载 pnpm”的交互提示，否则 CI/Docker 构建会卡住。
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@11.28.5 --activate \
    || npm install -g pnpm@11.28.5

# 安装所有依赖（含 devDependencies：typescript / vue-tsc / vite 都在 devDependencies 里）。
# ⚠️ store-dir 必须覆盖：pnpm-workspace.yaml 里把 store 写死成了本机 Windows 路径，
#    在 Linux 容器里必须显式覆盖（原因见 Dockerfile.api）。
RUN pnpm install --frozen-lockfile --store-dir=/root/.local/share/pnpm/store

# 构建顺序：contract → web
# web 的类型来自 @app/contract（api 同理），必须先构建 contract。
RUN pnpm --filter @app/contract build
RUN pnpm --filter @app/web build

# ---------- 阶段 2：运行 ----------
FROM nginx:alpine AS runner

# 复制构建好的前端静态文件
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# 复制 Nginx 配置（含反向代理 + SSE 关闭缓冲 + 上传体积上限）
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://localhost/ || exit 1
